{
    "files.autoSave": "onFocusChange",
    "editor.fontSize": 15,
    "editor.fontFamily": "'InconsolataGo Nerd Font Mono'",
    "editor.wordWrap": "on",
    "terminal.integrated.fontFamily": "'Courier Prime'",
    "cmake.configureOnOpen": true,

    "C_Cpp.intelliSenseEngine": "disabled",
    "ccls.completion.detailedLabel": true,
    "ccls.misc.compilationDatabaseDirectory": "build",
    "ccls.codeLens.enabled": false,
    "ccls.launch.args": [
        "--init={\"clang\":{\"resourceDir\":\"C:/local/ccls/22\"}}"
    ],
    
    "cmake.debugConfig": {
        "console": "externalTerminal",
        "setupCommands": [
            {
                "description": "-gdb-set charset utf-8",
                "text": "-gdb-set charset UTF-8"
            },
            {
                "description": "Enable gdb pretty-printing",
                "text": "-enable-pretty-printing",
                "ignoreFailures": true
            }
        ],
        //"visualizerFile": "${workspaceRoot}/.vscode/qt6.natvis",
        "args": [
            "-t", "3"
        ]
    },
    "cmake.configureArgs": [
        "-Wno-dev",
        "-DCSP_PYTHON_EXPORT=ON"
    ],
    // "cmake.configureSettings": {
    //     "CMAKE_TOOLCHAIN_FILE": "${env:VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
    // },
    "cmake.options.statusBarVisibility": "visible",
    "cmake.generator": "Ninja",
    "C_Cpp.default.compileCommands": "${workspaceRoot}/build/compile_commands.json",
    "C_Cpp.default.cppStandard": "c++17",
    "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
    "editor.inlayHints.enabled": "off",
    "editor.unicodeHighlight.allowedLocales": {
        "ja": true,
        "zh-hant": true,
        "zh-hans": true
    }
}
